diff --git a/image/patches/glm53_hisparse_layout_addendum.py b/image/patches/glm53_hisparse_layout_addendum.py
new file mode 100644
index 0000000..e050fa7
--- /dev/null
+++ b/image/patches/glm53_hisparse_layout_addendum.py
@@ -0,0 +1,89 @@
+import sys
+from pathlib import Path
+
+# Uruchamiany W BUDZIE: dokleja 2 funkcje hisparse (z ery ddd6fbca) do layout.py v0.31.0.
+# Idempotent. Usage: python3 glm53_hisparse_layout_addendum.py <path to layout.py>
+
+add = (
+    "# this fork: two hisparse functions from the ddd6fbca era, missing from v0.31.0's layout.py\n"
+    "# (kindling's fixes/kv_cache_utils.py imports them; vendored from vllm@ddd6fbca)\n"
+    "try:\n"
+    "    from vllm.config import VllmConfig  # noqa: F401 (adnotacje)\n"
+    "except ImportError:\n"
+    "    VllmConfig = object\n"
+    "try:\n"
+    "    from vllm.v1.kv_cache_interface import KVCacheGroupSpec  # noqa: F401\n"
+    "except ImportError:\n"
+    "    KVCacheGroupSpec = object\n"
+    "\n"
+    "def get_hisparse_gpu_memory_usage(\n"
+    "    vllm_config: VllmConfig,\n"
+    "    kv_cache_groups: list[KVCacheGroupSpec],\n"
+    ") -> int:\n"
+    "    _, indexer_specs = _partition_hisparse_specs(kv_cache_groups)\n"
+    "    return sum(\n"
+    "        spec.max_memory_usage_bytes(vllm_config) for spec in indexer_specs.values()\n"
+    "    ) + sum(\n"
+    "        group.kv_cache_spec.max_memory_usage_bytes(vllm_config)\n"
+    "        for group in kv_cache_groups[1:]\n"
+    "    )\n"
+    "\n"
+    "def get_hisparse_kv_cache_config(\n"
+    "    vllm_config: VllmConfig,\n"
+    "    kv_cache_groups: list[KVCacheGroupSpec],\n"
+    "    available_memory: int,\n"
+    "    host_budget: int,\n"
+    "):\n"
+    "    from vllm.v1.kv_cache_interface import KVCacheConfig  # lazy (cykl modulow)\n"
+    "    from vllm.v1.core.kv_cache_utils import (\n"
+    "        _get_kv_cache_bytes_per_block,\n"
+    "        may_override_num_blocks,\n"
+    "        validate_kv_cache_layout,\n"
+    "    )\n"
+    "\n"
+    "    hisparse_layout = create_hisparse_layout(vllm_config, kv_cache_groups, host_budget)\n"
+    "    device_groups = hisparse_layout.device_groups\n"
+    "    layout = vllm_config.cache_config.get_resolved_kv_cache_layout()\n"
+    "    validate_kv_cache_layout(layout, device_groups)\n"
+    "    bytes_per_block = _get_kv_cache_bytes_per_block(\n"
+    "        device_groups,\n"
+    "        vllm_config.cache_config.block_size,\n"
+    "        use_mla=vllm_config.model_config.use_mla,\n"
+    "    )\n"
+    "    num_blocks = may_override_num_blocks(\n"
+    "        vllm_config, available_memory // bytes_per_block\n"
+    "    )\n"
+    "    num_gpu_blocks = num_blocks - hisparse_layout.host_pool_blocks\n"
+    "    return KVCacheConfig(\n"
+    "        num_blocks=num_blocks,\n"
+    "        kv_cache_groups=device_groups,\n"
+    "        kv_cache_tensors=hisparse_layout.kv_cache_tensors,\n"
+    "        vllm_config=vllm_config,\n"
+    "    )\n"
+)
+
+target = Path(sys.argv[1])
+s = target.read_text()
+if "nasza adaptacja: 2 funkcje hisparse" not in s:
+    target.write_text(s + "\n\n" + add)
+    print("[hisparse-addendum] appended to", target)
+else:
+    print("[hisparse-addendum] already applied to", target)
+
+# 2) re-eksport na KONCU kv_cache_utils (kv_transfer/decode_bench importuja z tego modulu)
+kcu = target.parent.parent / "core" / "kv_cache_utils.py"
+ks = kcu.read_text()
+reexport = (
+    "\n# this fork: re-export hisparse helpers (kv_transfer/decode_bench expect them here)\n"
+    "from vllm.v1.hisparse.layout import (  # noqa: E402\n"
+    "    get_hisparse_gpu_memory_usage,\n"
+    "    get_hisparse_host_pool_bytes,\n"
+    "    get_hisparse_kv_cache_config,\n"
+    "    get_hisparse_kv_cache_groups,\n"
+    ")\n"
+)
+if "re-eksport hisparse helpers" not in ks:
+    kcu.write_text(ks + reexport)
+    print("[hisparse-addendum] re-export appended to", kcu)
+else:
+    print("[hisparse-addendum] re-export already present")
